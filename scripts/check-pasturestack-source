#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

fail()
{
    printf 'PASTURESTACK_SOURCE_GATE_FAIL reason=%s\n' "$1" >&2
    exit 1
}

require_line()
{
    local file=$1
    local line=$2
    tr -d '\r' <"$file" | grep -Fx -- "$line" >/dev/null || fail "required_line_missing:${file}:${line}"
}

require_text()
{
    local file=$1
    local value=$2
    tr -d '\r' <"$file" | grep -F -- "$value" >/dev/null || fail "required_text_missing:${file}:${value}"
}

settings=resources/content/cattle-global.properties
release_base=https://github.com/PastureStack/server/releases/download/v1.6.270

git diff --check
if [[ "${PASTURESTACK_ALLOW_DIRTY_GATE:-false}" != "true" && "${PASTURESTACK_ALLOW_STAGED_GATE:-false}" != "true" ]]; then
    git diff --quiet || fail tracked_worktree_changes
    git diff --cached --quiet || fail staged_changes
elif [ "${PASTURESTACK_ALLOW_DIRTY_GATE:-false}" != "true" ]; then
    git diff --quiet || fail tracked_worktree_changes
fi

