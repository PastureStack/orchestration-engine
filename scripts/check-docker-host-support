#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

fail()
{
    printf 'DOCKER_HOST_SUPPORT_GATE_FAIL reason=%s\n' "$1" >&2
    exit 1
}

require_line()
{
    local file=$1
    local line=$2
    tr -d '\r' <"$file" | grep -Fx -- "$line" >/dev/null || fail "required_line_missing:${file}:${line}"
}

defaults=code/packaging/app-config/src/main/resources/META-INF/cattle/api-server/defaults.properties
supported='supported.docker.range=~v1.12.3 || ~v1.13.0 || ~v17.03.0 || ~v17.06.0 || ~v17.09.0 || ~v17.12.0 || ~v18.03.0 || ~v18.06.0 || ~v18.09.0 || ~v19.03.2 || v24.0.9 || >=v29.4.1 <=v29.7.2'

require_line "$defaults" "$supported"
require_line "$defaults" 'newest.docker.version=v29.7.2'
require_line Makefile 'DOCKER_VERSION ?= 29.7.2'
require_line Dockerfile 'ARG DOCKER_VERSION=29.7.2'
require_line Dockerfile.dapper 'ARG DOCKER_VERSION=29.7.2'
require_line Dockerfile 'FROM golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466 AS docker-cli-build'
require_line Dockerfile.dapper 'FROM golang:1.27.0-bookworm@sha256:484ef6066fa69acb059fdfeda7ba2b8f7391f2ef6abc6f9b8411e669ebd56466 AS docker-cli-build'
require_line Dockerfile 'ARG DOCKER_CLI_COMMIT=a7dcaa6fdb6ed04aacbfdc76357fdae01605609e'
require_line Dockerfile.dapper 'ARG DOCKER_CLI_COMMIT=a7dcaa6fdb6ed04aacbfdc76357fdae01605609e'
require_line Dockerfile 'ADD --checksum=sha256:6e5c91d3a5a79db78cf989d07727d00e757aa0da4d135a3ce4b86061b83fb511 https://codeload.github.com/docker/cli/tar.gz/a7dcaa6fdb6ed04aacbfdc76357fdae01605609e /tmp/docker-cli.tar.gz'
require_line Dockerfile.dapper 'ADD --checksum=sha256:6e5c91d3a5a79db78cf989d07727d00e757aa0da4d135a3ce4b86061b83fb511 https://codeload.github.com/docker/cli/tar.gz/a7dcaa6fdb6ed04aacbfdc76357fdae01605609e /tmp/docker-cli.tar.gz'

if grep -Fq 'download.docker.com/linux/static/stable' Dockerfile Dockerfile.dapper; then
    fail vulnerable_prebuilt_docker_cli
fi

if grep -Eq 'supported\.docker\.range=.*(v29\.4\.1 \|\| v29\.7\.2|~v29|v2[5-8]\.)' "$defaults"; then
    fail incorrect_modern_range
fi

printf 'DOCKER_HOST_SUPPORT_GATE_OK newest=29.7.2 exact_legacy_modern=24.0.9 docker_29_range=29.4.1..29.7.2 docker_29_6_2=supported broad_25_to_28=0\n'
