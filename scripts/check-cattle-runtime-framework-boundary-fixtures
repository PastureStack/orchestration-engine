#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

workdir=$(mktemp -d "${TMPDIR:-/tmp}/cattle-runtime-framework.XXXXXX")
trap 'rm -rf "$workdir"' EXIT

write_pom() {
    local path="$1"
    local spring_version="$2"
    local jetty_version="${3:-12.1.12}"
    mkdir -p "$(dirname "$path")"
    cat >"$path" <<XML
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fixture</groupId>
  <artifactId>fixture</artifactId>
  <version>1</version>
  <properties>
    <spring.version>${spring_version}</spring.version>
    <jetty.version>${jetty_version}</jetty.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>\${spring.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>\${jetty.version}</version>
    </dependency>
  </dependencies>
</project>
XML
}

positive_spring7="$workdir/positive-spring7"
write_pom "$positive_spring7/pom.xml" "7.0.9"
mkdir -p "$positive_spring7/code/packaging/app/target/app/WEB-INF/lib"
: >"$positive_spring7/code/packaging/app/target/app/WEB-INF/lib/spring-core-7.0.9.jar"
: >"$positive_spring7/code/packaging/app/target/app/WEB-INF/lib/jetty-server-12.1.12.jar"
RC16_CATTLE_SOURCE_ROOT="$positive_spring7" scripts/check-cattle-runtime-framework-boundary >"$workdir/positive-spring7.out"
grep -Fq 'CATTLE_RUNTIME_FRAMEWORK_BOUNDARY_OK spring_floor=7.0.9' "$workdir/positive-spring7.out"

spring6="$workdir/spring-6"
write_pom "$spring6/pom.xml" "6.2.19"
if RC16_CATTLE_SOURCE_ROOT="$spring6" scripts/check-cattle-runtime-framework-boundary >"$workdir/spring-6.out" 2>&1; then
    echo "expected end-of-life Spring 6 fixture to fail" >&2
    cat "$workdir/spring-6.out" >&2
    exit 1
fi
grep -Fq 'spring.version=6.2.19 < 7.0.9' "$workdir/spring-6.out"

spring708="$workdir/spring-7.0.8"
write_pom "$spring708/pom.xml" "7.0.8"
if RC16_CATTLE_SOURCE_ROOT="$spring708" scripts/check-cattle-runtime-framework-boundary >"$workdir/spring-7.0.8.out" 2>&1; then
    echo "expected Spring below the maintained floor to fail" >&2
    cat "$workdir/spring-7.0.8.out" >&2
    exit 1
fi
grep -Fq 'spring.version=7.0.8 < 7.0.9' "$workdir/spring-7.0.8.out"

future_stable="$workdir/future-stable"
write_pom "$future_stable/pom.xml" "7.1.0"
RC16_CATTLE_SOURCE_ROOT="$future_stable" scripts/check-cattle-runtime-framework-boundary >"$workdir/future-stable.out"
grep -Fq 'CATTLE_RUNTIME_FRAMEWORK_BOUNDARY_OK spring_floor=7.0.9' "$workdir/future-stable.out"

spring7_milestone="$workdir/spring7-milestone"
write_pom "$spring7_milestone/pom.xml" "7.1.0-M1"
if RC16_CATTLE_SOURCE_ROOT="$spring7_milestone" scripts/check-cattle-runtime-framework-boundary >"$workdir/spring7-milestone.out" 2>&1; then
    echo "expected Spring 7 milestone fixture to fail" >&2
    cat "$workdir/spring7-milestone.out" >&2
    exit 1
fi
grep -Fq 'uses an unreviewed qualifier' "$workdir/spring7-milestone.out"

echo "CATTLE_RUNTIME_FRAMEWORK_BOUNDARY_FIXTURES_OK"
