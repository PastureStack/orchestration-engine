#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

java_cmd=${JAVA_CMD:-java}
runner_image=${RC16_CATTLE_STANDALONE_JDK_IMAGE:-maven:3.9.16-eclipse-temurin-25@sha256:1b1fc6d0168ea616afd1c861d6f32ec37c9ec2ffe88a0351b3771dd4ad86b0d8}
expected_version=${EXPECTED_ENGINE_VERSION:-${ENGINE_VERSION:-0.183.355}}
artifact=${RC16_CATTLE_STANDALONE_JAR:-dist/artifacts/cattle.jar}

# Full-package invokes Maven directly, without scripts/build's final copy.
# Never prefer a stale bundle over the release WAR.
if [ -z "${RC16_CATTLE_STANDALONE_JAR:-}" ] && [ ! -f "$artifact" ]; then
    artifact="code/packaging/app/target/cattle-app-${expected_version}.war"
fi
if [ ! -f "$artifact" ]; then
    echo "Standalone WAR not found: $artifact" >&2
    exit 1
fi

python_cmd=${PYTHON:-}
if [ -z "$python_cmd" ]; then
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
            python_cmd=$candidate
            break
        fi
    done
fi
if [ -z "$python_cmd" ]; then
    echo "Python 3 is required for the isolated standalone WAR gate" >&2
    exit 2
fi

args=(--artifact "$artifact" --java "$java_cmd" --expected-version "$expected_version"
    --timeout "${RC16_CATTLE_STANDALONE_TIMEOUT_SECONDS:-180}")
# A direct full-package build can leave an older dist copy behind. Fail closed
# instead of certifying that stale copy while a different app WAR is present.
app_war="code/packaging/app/target/cattle-app-${expected_version}.war"
if [ -f "$app_war" ]; then
    args+=(--reference-artifact "$app_war")
fi
if [ -n "${RC16_CATTLE_STANDALONE_TMP:-}" ]; then
    args+=(--temporary-root "$RC16_CATTLE_STANDALONE_TMP")
fi
if [ "${RC16_KEEP_STANDALONE_TMP:-false}" = "true" ]; then
    args+=(--keep)
fi

# Native Python receives native paths through the shell's argv conversion;
# H2 paths and all Java arguments are then built without another shell.
if "$python_cmd" scripts/check-cattle-jdk25-standalone.py "${args[@]}"; then
    exit 0
else
    local_status=$?
fi
if [ "$local_status" -ne 2 ] || [ "${RC16_STANDALONE_IN_CONTAINER:-false}" = "true" ]; then
    exit "$local_status"
fi

# Retain the pinned offline fallback; never download an image to run this gate.
if ! command -v docker >/dev/null 2>&1; then
    exit "$local_status"
fi
artifact_abs=$(cd "$(dirname "$artifact")" && pwd)/$(basename "$artifact")
evidence_root=${RC16_CATTLE_STANDALONE_TMP:-$repo_root/target/standalone-evidence}
mkdir -p "$evidence_root"
docker run --rm --pull=never --network=none \
    -v "$repo_root:/work:ro" \
    -v "$artifact_abs:/standalone/cattle.jar:ro" \
    -v "$evidence_root:/evidence" \
    -w /work \
    -e RC16_STANDALONE_IN_CONTAINER=true \
    -e RC16_CATTLE_STANDALONE_JAR=/standalone/cattle.jar \
    -e RC16_CATTLE_STANDALONE_TMP=/evidence \
    -e RC16_KEEP_STANDALONE_TMP="${RC16_KEEP_STANDALONE_TMP:-false}" \
    -e RC16_CATTLE_STANDALONE_TIMEOUT_SECONDS="${RC16_CATTLE_STANDALONE_TIMEOUT_SECONDS:-180}" \
    -e EXPECTED_ENGINE_VERSION="$expected_version" \
    "$runner_image" bash scripts/check-cattle-jdk25-standalone
