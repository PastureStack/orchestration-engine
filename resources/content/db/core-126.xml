<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="PastureStack" dbms="mysql,mariadb,postgresql" id="pasturestack-session-bound-auth-token">
        <preConditions onFail="HALT">
            <tableExists tableName="auth_token"/>
            <not>
                <columnExists tableName="auth_token" columnName="client_session_id"/>
            </not>
        </preConditions>
        <addColumn tableName="auth_token">
            <column name="client_session_id" type="VARCHAR(128)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
