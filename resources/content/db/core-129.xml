<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="PastureStack" id="ai-catalog-stack-launch-plan">
        <createTable tableName="ai_catalog_stack_launch_plan">
            <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="actor_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="stack_id" type="BIGINT"><constraints unique="true"/></column>
            <column name="expires_at" type="BIGINT"><constraints nullable="false"/></column>
            <column name="document" type="CLOB"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="ai_catalog_stack_launch_plan" indexName="idx_ai_catalog_launch_owner">
            <column name="actor_id"/><column name="account_id"/><column name="state"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
